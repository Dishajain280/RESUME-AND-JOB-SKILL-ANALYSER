    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "axios": "^1.7.2",
    "recharts": "^2.12.7",
    "react-dropzone": "^14.2.3",
    "react-hot-toast": "^2.4.1",
    "lucide-react": "^0.390.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.3.0",
    "framer-motion": "^11.2.11",
    "@tanstack/react-query": "^5.45.0",
    "react-hook-form": "^7.52.0",
    "zod": "^3.23.8",
    "@hookform/resolvers": "^3.6.0"
