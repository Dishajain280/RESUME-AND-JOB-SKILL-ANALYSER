[TEMPLATE]
# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="AI Resume & Job Skill Analyser"
APP_VERSION="1.1.0"
DEBUG=false

# ── Security ───────────────────────────────────────────────────────────────────
# REQUIRED when DEBUG=false — the app refuses to start without it.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-64-char-random-hex-string

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default — good for development and single-server deployments)
DATABASE_URL=sqlite:///./resume_analyser.db
# PostgreSQL example (uncomment and fill in for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/resume_analyser
# Production should run `alembic upgrade head` instead of auto-creating tables:
# AUTO_CREATE_TABLES=false

# ── CORS / Proxy ───────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Set true ONLY when behind a trusted reverse proxy (nginx, Traefik...) that
# overwrites X-Forwarded-For / X-Real-IP — otherwise clients can spoof their IP.
TRUST_PROXY_HEADERS=false

# ── File Upload ────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
# Supported: .pdf, .docx, .txt (legacy .doc is rejected)

# ── AI / NLP ───────────────────────────────────────────────────────────────────
NLP_MODEL=en_core_web_sm
SIMILARITY_THRESHOLD=0.55
# Pre-load models at startup so the first request is fast
WARM_UP_MODELS_ON_STARTUP=true

# ── Rate Limiting ──────────────────────────────────────────────────────────────
# Redis enables shared counters across workers/replicas (recommended in prod).
# Empty → in-process counters (single worker only). Also enables docker-compose redis.
RATE_LIMIT_ENABLED=true
# REDIS_URL=redis://localhost:6379/0

# ── API Docs ───────────────────────────────────────────────────────────────────
# Disable on public production hosts if desired
ENABLE_DOCS=true

# ── Observability ──────────────────────────────────────────────────────────────
ENABLE_METRICS=true
# Optional Sentry error tracking (empty = disabled)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
