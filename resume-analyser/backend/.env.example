[TEMPLATE]
[TEMPLATE]
# ── Application ─────────────────────────────────────────────────────────
APP_NAME="AI Resume & Job Skill Analyser"
APP_VERSION="1.1.0"
DEBUG=false

# ── Security ─────────────────────────────────────────────────────────────
# REQUIRED when DEBUG=false — the app refuses to start without it.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-64-char-random-hex-string

# ── Database ─────────────────────────────────────────────────────────────
# SQLite (default — good for development and single-server deployments)
DATABASE_URL=sqlite:///./resume_analyser.db
# PostgreSQL example (uncomment and fill in for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/resume_analyser
# Production should run `alembic upgrade head` instead of auto-creating tables:
# AUTO_CREATE_TABLES=false
#
# Vercel: SQLite is NOT writable on the serverless filesystem — create a
# Vercel Postgres database and attach it to the backend service; it
# injects DATABASE_URL automatically (leave this var unset in that case).

# ── CORS / Proxy ───────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# On Vercel the frontend is served from the same domain, so cross-origin
# CORS is not needed; these defaults are for local dev only.
# Set true ONLY when behind a trusted reverse proxy (nginx, Traefik,
# Vercel...) that overwrites X-Forwarded-For / X-Real-IP — otherwise
# clients can spoof their IP and bypass rate limits.
TRUST_PROXY_HEADERS=false
# Vercel sets X-Forwarded-For on every request — set TRUST_PROXY_HEADERS=true
# there, otherwise every user shares a single rate-limit bucket.

# ── File Upload ────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
# Vercel caps request bodies at 4.5 MB (Hobby and Pro plans) — set
# MAX_UPLOAD_SIZE_MB=4 as a backend env var there; larger uploads are
# rejected with 413 before reaching the app.
# Supported: .pdf, .docx, .txt, .rtf, .odt, .md, .html, .csv + images (OCR)

# ── AI / NLP ───────────────────────────────────────────────────────────
NLP_MODEL=en_core_web_sm
SIMILARITY_THRESHOLD=0.55
# Pre-load models at startup so the first request is fast (persistent
# servers only — pointless on serverless, where each cold start re-runs it)
WARM_UP_MODELS_ON_STARTUP=true
# Vercel: set WARM_UP_MODELS_ON_STARTUP=false.

# ── Rate Limiting ──────────────────────────────────────────────────────
# Redis enables shared counters across workers/replicas (recommended in prod).
# Empty → in-process counters (single worker only). Also enables docker-compose redis.
RATE_LIMIT_ENABLED=true
# REDIS_URL=redis://localhost:6379/0
# Vercel: in-process counters are per-sandbox; for true shared limits,
# set REDIS_URL to an Upstash/Redis instance.

# ── API Docs ───────────────────────────────────────────────────────────
# Disable on public production hosts if desired
ENABLE_DOCS=true

# ── Observability ──────────────────────────────────────────────────────
ENABLE_METRICS=true
# Optional Sentry error tracking (empty = disabled)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
